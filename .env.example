# ==============================================================================
# Learn Code With Me — Environment Variables
# Copy this file to .env.local for local development and set all values in
# Vercel Project Settings -> Environment Variables for production.
# NEVER commit .env.local or real secrets to version control.
# ==============================================================================

# --- Supabase (Required) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Server-only key used exclusively in verified server routes/admin operations:
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# --- App URL (Required for Auth callbacks & password reset links) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Judge0 Sandboxed Code Execution Engine (Required for real C & Python execution) ---
# Option A: Self-hosted Judge0 CE (e.g. https://judge0.yourdomain.com)
# Option B: RapidAPI Judge0 CE (https://judge0-ce.p.rapidapi.com)
JUDGE0_API_URL="https://judge0-ce.p.rapidapi.com"
JUDGE0_API_KEY=""
# Set JUDGE0_RAPIDAPI_HOST="judge0-ce.p.rapidapi.com" only if using RapidAPI
JUDGE0_RAPIDAPI_HOST="judge0-ce.p.rapidapi.com"
# Language IDs (Judge0 CE defaults: C GCC 9.2.0 = 50, Python 3.8.1 = 71)
JUDGE0_C_LANGUAGE_ID="50"
JUDGE0_PYTHON_LANGUAGE_ID="71"
# Resource limits per test case
JUDGE0_CPU_TIME_LIMIT="2.0"
JUDGE0_MEMORY_LIMIT_KB="128000"

# --- Gemini API (Required for AI Teaching Assistant & Knowledge Verification) ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
